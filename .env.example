# Copy this file to .env for local configuration.
# Replace SECRET_KEY with a long random value before deployment.
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///ldica.db

# Optional: email address of an already-registered academic administrator.
# If unset, academic admin actions remain disabled.
LDICA_ADMIN_EMAIL=

# Optional: set to 1 only when serving over HTTPS; leave unset for local HTTP.
# SESSION_COOKIE_SECURE=1
